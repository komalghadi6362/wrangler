✅ Step 4: Implement `ByteSize.java`

**Location:**
```
wrangler-transform/src/main/java/io/cdap/wrangler/steps/transform/ByteSize.java
```

**Code:**
```java
package io.cdap.wrangler.steps.transform;

import io.cdap.wrangler.api.Row;
import io.cdap.wrangler.api.Step;
import io.cdap.wrangler.api.SkipRowException;
import io.cdap.wrangler.api.StepException;

import java.util.ArrayList;
import java.util.List;

public class ByteSize implements Step {
  private final String column;
  private final String target;

  public ByteSize(String column, String target) {
    this.column = column;
    this.target = target;
  }

  @Override
  public List<Row> execute(Row row) throws StepException, SkipRowException {
    Object value = row.getValue(column);
    if (value == null) {
      row.addOrSet(target, 0);
    } else {
      row.addOrSet(target, value.toString().getBytes().length);
    }
    List<Row> rows = new ArrayList<>();
    rows.add(row);
    return rows;
  }
}
```

