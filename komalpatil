package io.cdap.wrangler.steps.transform;

import io.cdap.wrangler.api.Row;
import org.junit.Assert;
import org.junit.Test;

import java.util.List;

public class ByteSizeTest {
  @Test
  public void testByteSize() throws Exception {
    Row row = new Row("text", "hello world");
    ByteSize step = new ByteSize("text", "size");
    List<Row> result = step.execute(row);
    Assert.assertEquals(11, result.get(0).getValue("size"));
  }
}
